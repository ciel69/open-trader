{
  "version": 1,
  "_comment": "Платформа v2 (WP11-B). Недостающие ключи берутся из tb.platform.services.DEFAULTS. Описание: docs/RUNBOOK.md",
  "profile": "paper",
  "services": {
    "paper": [
      "exec",
      "scan",
      "feed",
      "context",
      "intel",
      "sync",
      "dispatch",
      "ctl",
      "dash",
      "brain"
    ],
    "testnet": [
      "exec",
      "scan",
      "feed",
      "context",
      "intel",
      "sync",
      "dispatch",
      "ctl",
      "dash",
      "brain"
    ],
    "trade": [
      "exec",
      "scan",
      "feed",
      "context",
      "intel",
      "sync",
      "dispatch",
      "ctl",
      "dash"
    ]
  },
  "supervisor": {
    "poll_s": 1.0,
    "status_s": 2.0,
    "stop_grace_s": 8.0,
    "exec_stop_grace_s": 20.0,
    "stable_s": 120.0,
    "restart": {
      "base_s": 2.0,
      "factor": 2.0,
      "max_s": 60.0,
      "max_tries": 5
    },
    "retry_after_giveup_s": 900.0,
    "fatal_codes": [
      2,
      4
    ],
    "fatal_within_s": 10.0,
    "down_event_repeat_s": 3600.0,
    "log": {
      "max_bytes": 1048576,
      "keep": 3
    }
  },
  "svc": {
    "exec": {
      "hb": "exec",
      "hb_stale_s": 60.0,
      "grace_s": 90.0
    },
    "scan": {
      "hb": "file",
      "hb_stale_s": 120.0,
      "grace_s": 60.0
    },
    "feed": {
      "hb": "none"
    },
    "dispatch": {
      "hb": "file",
      "hb_stale_s": 30.0,
      "grace_s": 30.0
    },
    "ctl": {
      "hb": "file",
      "hb_stale_s": 30.0,
      "grace_s": 30.0
    },
    "dash": {
      "hb": "none",
      "port": 8765
    },
    "mcp": {
      "hb": "none",
      "module": "tb.mcp.server",
      "args": [
        "serve"
      ],
      "port": 8766
    },
    "brain": {
      "hb": "file",
      "hb_stale_s": 300.0,
      "grace_s": 60.0,
      "module": "tb.brain.api_daemon",
      "args": [
        "run"
      ]
    },
    "intel": {
      "hb": "file",
      "hb_stale_s": 180.0,
      "grace_s": 90.0
    },
    "context": {
      "hb": "file",
      "hb_stale_s": 180.0,
      "grace_s": 60.0
    },
    "sync": {
      "hb": "file",
      "hb_stale_s": 900.0,
      "grace_s": 90.0
    }
  },
  "scan": {
    "env": "mainnet",
    "interval": 30.0,
    "top": 10,
    "min_turnover": 5000000.0,
    "max_spread_bps": 8.0,
    "max_lot": 15.0,
    "range_pct": 0.8,
    "surge_min": 4.0,
    "cooldown": 1200.0,
    "wake_score": 4.0,
    "max_per_hour": 12,
    "idea_zone_pct": 0.3,
    "outcome_min": "15,60",
    "publish_info": true,
    "dedup_s": {
      "default": 300.0,
      "idea_near": 1800.0,
      "idea_level": 86400.0,
      "idea_invalidated": 86400.0,
      "idea_tp": 86400.0,
      "idea_expired": 86400.0
    },
    "hb_s": 5.0
  },
  "dispatch": {
    "poll_s": 1.0,
    "retry_base_s": 2.0,
    "retry_max_s": 60.0,
    "max_attempts": 5,
    "api": {
      "jobs_per_hour": 12,
      "critical_per_hour": 30,
      "coalesce_s": 60.0,
      "settle_s": 5.0,
      "max_seqs": 20
    },
    "queue_keep": 2000,
    "classes": {
      "connectivity": 0,
      "kill": 0,
      "limit_hit": 0,
      "error": 0,
      "reconcile_alert": 0,
      "service_down": 0,
      "exec_down": 0,
      "exec_stopped": 0,
      "exec_started": 1,
      "plan_armed": 1,
      "plan_rejected": 1,
      "trigger_fired": 1,
      "entry_blocked": 1,
      "entry_filled": 1,
      "position_closed": 1,
      "plan_ended": 1,
      "action_rejected": 1,
      "stop_moved": 1,
      "rule_fired": 1,
      "session_ending": 1,
      "brain_wake_request": 1,
      "milestone": 2,
      "brain_swap": 2,
      "scanner_signal": 3
    }
  },
  "links": {
    "dash": "http://127.0.0.1:{dash_port}/"
  },
  "context": {
    "poll_s": 15.0
  },
  "sync": {
    "interval_min": 5.0,
    "venue": "bybit",
    "max_dev_frac": 0.1,
    "stale_min": 15.0,
    "hwm_confirm_reads": 2
  }
}
